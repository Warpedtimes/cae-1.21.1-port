    { "structure": "create_structures_arise:createmonsterroom", "factor": 2 },
    { "structure": "create_structures_arise:createoldruine", "factor": 2 },
    { "structure": "create_structures_arise:createpickaxestatue", "factor": 2 },
    { "structure": "create_structures_arise:createwitchhut", "factor": 2 },
    { "structure": "create_structures_arise:create_bastion", "factor": 2 },
    { "structure": "create_structures_arise:create_copper_statue", "factor": 2 },
    { "structure": "create_structures_arise:create_dungeon_base", "factor": 2 },
    { "structure": "create_structures_arise:create_ruined_castle", "factor": 2 },
    { "structure": "create_structures_arise:crimsite_tower", "factor": 2 },
    { "structure": "create_structures_arise:darkcastle", "factor": 2 },
    { "structure": "create_structures_arise:honey_pit", "factor": 2 },
    { "structure": "create_structures_arise:minetrain", "factor": 2 },
    { "structure": "create_structures_arise:pillagersteampunkairship", "factor": 2 },
    { "structure": "create_structures_arise:pillager_boat", "factor": 2 },
    { "structure": "create_structures_arise:towerofochrum", "factor": 2 },
    { "structure": "create_structures_arise:windmill", "factor": 2 },
    // the two denser ones get the global 3: deadlordshouse (50/15) and obsidiantemple (60/15)

    // Moog's Soaring Structures: 53-158 chunks apart already
    { "structure": "mss:diorite_house", "factor": 1.5 },
    { "structure": "mss:desert_pyramid", "factor": 1.5 },
    { "structure": "mss:nether_portal", "factor": 1.5 },
    { "structure": "mss:desert_well", "factor": 2 },
    { "structure": "mss:castle_tower", "factor": 1.5 },
    { "structure": "mss:birch_river", "factor": 1.5 },
    { "structure": "mss:castle_ruin", "factor": 1.5 },
    { "structure": "mss:small_pond", "factor": 2 },
    { "structure": "mss:red_sand", "factor": 1.5 },
    { "structure": "mss:frozen_pond", "factor": 1.5 },
    { "structure": "mss:trees", "factor": 2 },
    { "structure": "mss:volcano", "factor": 1.5 },
    { "structure": "mss:muddy_water_hole", "factor": 1.5 },
    { "structure": "mss:mangrove", "factor": 2 },
    { "structure": "mss:mushroom", "factor": 1.5 },
    { "structure": "mss:palm_island", "factor": 1.5 },
    { "structure": "mss:leaf_hollow", "factor": 1.5 },
    { "structure": "mss:taiga", "factor": 1.5 },
    { "structure": "mss:large_tower", "factor": 1.5 },
    { "structure": "mss:small_tower", "factor": 1.5 },
    { "structure": "mss:white_house", "factor": 1.5 },
    { "structure": "mss:small_oak_house", "factor": 1.5 },
