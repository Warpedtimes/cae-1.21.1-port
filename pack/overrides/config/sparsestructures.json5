    // Moog's Nether Structures: the big, already-rare ones
    { "structure": "mns:mega_fortress", "factor": 1.5 },
    { "structure": "mns:mega_arenas", "factor": 1.5 },
    { "structure": "mns:nether_tower", "factor": 1.5 },
    { "structure": "mns:bridge_1", "factor": 1.5 },
    { "structure": "mns:bridge_2", "factor": 1.5 },
    { "structure": "mns:bridge_3", "factor": 1.5 },
    { "structure": "mns:bridge_4", "factor": 1.5 },
    { "structure": "mns:bridge_5", "factor": 1.5 },
    { "structure": "mns:bridge_6", "factor": 1.5 }
  ]
